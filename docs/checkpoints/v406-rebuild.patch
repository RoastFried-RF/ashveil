diff --git a/src/core/food-exposure-state.ts b/src/core/food-exposure-state.ts
new file mode 100644
index 00000000..73cf77e5
--- /dev/null
+++ b/src/core/food-exposure-state.ts
@@ -0,0 +1,44 @@
+import {turnOf,TURNS_PER_DAY,type World} from './ctx'
+import type {Creature,FoodExposureRecord,FoodExposureRule,FoodSafetyDef} from './types'
+
+export function validFoodExposureRule(rule:FoodExposureRule):boolean {
+ if(!rule||typeof rule!=='object')return false
+ return typeof rule.food==='string'&&!!rule.food&&typeof rule.disease==='string'&&!!rule.disease
+  &&[rule.servings,rule.durationDays].every(n=>Number.isSafeInteger(n)&&n>=1&&n<=366)
+  &&Number.isSafeInteger(rule.minIntervalTurns)&&rule.minIntervalTurns>=1
+  &&Number.isSafeInteger(rule.maxGapTurns)&&rule.maxGapTurns>=rule.minIntervalTurns
+  &&Number.isFinite(rule.lungDose)&&rule.lungDose>=0&&rule.lungDose<=100
+  &&Number.isFinite(rule.riskMult)&&rule.riskMult>0&&rule.riskMult<=1
+  &&(rule.knowledgeBook===undefined||typeof rule.knowledgeBook==='string')
+}
+export const foodExposureSignature=(r:FoodExposureRule)=>JSON.stringify([r.food,r.disease,r.servings,r.durationDays,r.minIntervalTurns,r.maxGapTurns,r.lungDose,r.riskMult,r.knowledgeBook??null])
+export function foodExposureRules(w:World):FoodExposureRule[]{
+ const rules=w.db.tryGet<FoodSafetyDef>('FoodSafety.Human')?.exposureTraining
+ return Array.isArray(rules)?rules.filter(validFoodExposureRule):[]
+}
+export function foodExposureRecords(c:Creature):FoodExposureRecord[]{
+ return Array.isArray(c.foodExposureTraining)?c.foodExposureTraining.filter(r=>r&&validFoodExposureRule(r.rule)&&Number.isSafeInteger(r.doseCount)&&r.doseCount>=0):[]
+}
+function validCourse(r:FoodExposureRecord){
+ const rows=r.course?.receipts
+ return Array.isArray(rows)&&rows.length<=r.rule.servings&&rows.length<=r.doseCount&&rows.every((row,i)=>row&&Number.isSafeInteger(row.uid)&&row.uid>0&&Number.isSafeInteger(row.at)&&row.at>=0&&(!i||row.at-rows[i-1].at>=r.rule.minIntervalTurns&&row.at-rows[i-1].at<=r.rule.maxGapTurns))
+}
+export function foodExposureCompletion(r:FoodExposureRecord,at:number):boolean {
+ if(!validCourse(r))return false
+ const rows=r.course!.receipts
+ return rows.length===r.rule.servings&&at>=rows[0].at+r.rule.durationDays*TURNS_PER_DAY&&at>=rows.at(-1)!.at&&at<=rows.at(-1)!.at+r.rule.maxGapTurns
+}
+export const foodExposureCompleted=(r:FoodExposureRecord,now:number)=>Number.isSafeInteger(r.completedAt)&&r.completedAt!>=0&&r.completedAt!<=now&&foodExposureCompletion(r,r.completedAt!)
+/** Food-associated pulmonary injury is separate from both inhaled dust and renal ash. */
+export const foodExposureLungDose=(c:Creature)=>foodExposureRecords(c).reduce((sum,r)=>sum+r.doseCount*r.rule.lungDose/r.rule.servings,0)
+export function foodExposureDiseaseMultiplier(w:World,c:Creature,disease:string){
+ return foodExposureRecords(c).reduce((mult,r)=>r.rule.disease===disease&&foodExposureCompleted(r,turnOf(w))?Math.min(mult,r.rule.riskMult):mult,1)
+}
+export function foodExposureLines(w:World,c:Creature):string[]{
+ return foodExposureRecords(c).flatMap(r=>{
+  const book=r.rule.knowledgeBook
+  if(!book||!c.booksRead?.includes(book)||!(c.literacyBooks??c.booksRead).includes(book)||c.misreadBooks?.includes(book)||!w.db.has(r.rule.food)||!w.db.has(r.rule.disease))return[]
+  const servings=validCourse(r)?r.course!.receipts.length:0
+  return[w.db.item(r.rule.food).label+' · 실제 섭취 '+r.doseCount+'회 · 간격을 지킨 식사 '+servings+'/'+r.rule.servings+'회 · 음식성 재폐 부담 '+(r.doseCount*r.rule.lungDose/r.rule.servings).toFixed(2),foodExposureCompleted(r,turnOf(w))?w.db.get(r.rule.disease).label+' 노출 위험 ×'+r.rule.riskMult+' · 완전 면역이나 현재 감염의 치료는 아니다.':r.rule.durationDays+'일 경과와 식사 간격이 필요하다. 몰아 먹거나 간격을 놓쳐도 폐 부담은 사라지지 않는다.']
+ })
+}
diff --git a/src/core/food-exposure.ts b/src/core/food-exposure.ts
new file mode 100644
index 00000000..6835d874
--- /dev/null
+++ b/src/core/food-exposure.ts
@@ -0,0 +1,36 @@
+import {log,turnOf,type World} from './ctx'
+import type {Creature,ItemInst} from './types'
+import {ashLungStage} from './air-state'
+import {foodExposureCompleted,foodExposureCompletion,foodExposureRecords,foodExposureRules,foodExposureSignature} from './food-exposure-state'
+
+export function foodExposureTick(w:World,c:Creature){
+ const now=turnOf(w)
+ for(const r of foodExposureRecords(c)){
+  if(foodExposureCompleted(r,now))continue
+  if(foodExposureCompletion(r,now)){
+   r.completedAt=now
+   if(c.faction==='player')log(w,'info','간격을 지킨 식사를 '+r.rule.durationDays+'일 동안 이어 왔다.')
+  }else if(r.course?.receipts?.length&&now>r.course.receipts.at(-1)!.at+r.rule.maxGapTurns)delete r.course
+ }
+}
+/** Called only after actual food consumption succeeds, before its original vessel returns. */
+export function recordFoodExposure(w:World,c:Creature,it:ItemInst,retained:boolean){
+ if(!c.alive||w.db.body(c.body.def).kind==='mechanical'||c.foodExposureTraining!==undefined&&!Array.isArray(c.foodExposureTraining))return
+ const rules=foodExposureRules(w).filter(r=>r.food===it.def)
+ if(!rules.length)return
+ foodExposureTick(w,c)
+ const now=turnOf(w),before=ashLungStage(w,c)
+ for(const rule of rules){
+  let r=foodExposureRecords(c).find(row=>foodExposureSignature(row.rule)===foodExposureSignature(rule))
+  if(!r){r={rule:{...rule},doseCount:0};(c.foodExposureTraining??=[]).push(r)}
+  if(r.doseCount>=Number.MAX_SAFE_INTEGER)continue
+  r.doseCount++
+  if(!retained||foodExposureCompleted(r,now))continue
+  const last=r.course?.receipts?.at(-1)
+  if(last&&now-last.at<rule.minIntervalTurns)continue
+  if(!last||now-last.at>rule.maxGapTurns)r.course={receipts:[]}
+  r.course!.receipts.push({uid:it.uid,at:now})
+  if(r.course!.receipts.length>rule.servings)r.course!.receipts.shift()
+ }
+ if(c.faction==='player'&&ashLungStage(w,c)>before)log(w,'warning','음식에 섞인 재가 폐에 부담을 남겼다.')
+}
