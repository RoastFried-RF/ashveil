  "staticCallerSelectionReview": {
    "sources": [
      {
        "path": "src/client/ui/ResidentDepotPanel.vue",
        "bytes": 3366,
        "sha256": "242b6d38d9fc7c8f5daa5041e79417898e763837ec5f91659dc3ebe0f6e4d99f"
      },
      {
        "path": "src/core/settlement-supply.ts",
