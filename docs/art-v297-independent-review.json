        "sha256": "1deb4028ed8e7d03e50d6200fc45a70ec2578dea1e986ccec18da90ed35a31d6"
      },
      {
        "path": "src/client/ui/ItemIcon.vue",
        "bytes": 1193,
        "sha256": "f9abb6a4b7a49708b3aadb8c01f66026b3fc56c4d93aab6046596c0905429982"
      }
    ],
    "integration": "ResidentDepotPanel renders ItemIcon name original_pantry_ + data.status at size 32; each status resolves to its corresponding new native frame.",
    "contextVisibility": "Read-only helper returns null unless player is alive/awake/conscious, at the actual current-region resident depot within one tile with LOS/visibility and matching actual residentDepot terrain/stock. Panel v-if=data follows that gate; these rules were read, not run.",
    "actualReadInputs": {
      "alivePopulation": "stock.population.S + stock.population.I + stock.population.R",
      "food": "max(0, stock.reserve.Food ?? 0)",
      "foodRate": "worldSimulationDef(w).consumption.Food ?? 0",
      "oneSettlementDay": "population * foodRate"
    },
    "branches": [
      {
        "condition": "food <= 0",
        "key": "original_pantry_empty",
        "text": "공동 식량이 비었다",
        "precedence": "First, including zero population or zero consumption criterion."
      },
      {
        "condition": "food > 0 and foodDaily > 0 and food < foodDaily",
        "key": "original_pantry_low",
        "text": "정착지 하루분 미만"
      },
      {
        "condition": "food > 0 and foodDaily > 0 and food >= foodDaily",
        "key": "original_pantry_full",
        "text": "정착지 하루분 이상",
        "equality": "Exactly one settlement day is full."
      },
      {
        "condition": "food > 0 and foodDaily <= 0, including population=0 or foodRate=0",
        "key": "original_pantry_full",
        "text": "공동 식량 있음 · 정착지 하루 기준 없음",
        "qualification": "The artwork is the full fallback, but visible text does not claim a measured settlement day. foodSettlementDays is null."
      }
    ],
    "quantities": "When foodRate>0, foodPersonDays = quantize(food/foodRate); when foodDaily>0, foodSettlementDays = quantize(food/foodDaily). quantize rounds to 1e-9. UI formats Korean locale to at most two decimals and labels person-day values 약. Selection compares raw reserve and daily need, rather than rounded display values.",
    "zeroCriterionDetails": "foodRate=0 omits undefined person-day division and shows 식량 소비 기준이 설정되어 있지 않다. Positive reserve with population=0 still shows person-days if the food rate is positive but explicitly says no settlement-day criterion; empty reserve retains the empty text first.",
    "stockDistinction": "The panel now names marketRationFood as only shop items convertible through WorldSimulation.Hearth.items into the Food commodity, displayed in person-days and separate from common reserve. It directs readers to the trade list for other edibles. A zero value does not assert that the shop has no food. Pantry icon status still uses common reserve alone.",
    "actualLedger": "When lastSupply.commodities.Food exists and foodRate>0, display completed day+1 and the recorded population; produced/requested/supplied/residentUsed are displayed separately. unmet>0 displays the recorded unmet amount; otherwise the text is only 기록된 공동 식량 요청을 모두 충당했다.",
    "ledgerSemanticsLimit": "Current reserve status and completed-day ledger are distinct. The green met text describes recorded common requests only; it does not guarantee personal nutrition, no famine, health, future production or harvest. No completed ledger shows the explicit unrecorded text. Helper structuredClone protects stored lastSupply from returned-object mutation; no runtime mutation test performed.",
    "visibleExactText": [
      "공동 식량이 비었다",
      "공동 식량 있음 · 정착지 하루 기준 없음",
      "정착지 하루분 미만",
      "정착지 하루분 이상",
      "식량 소비 기준이 설정되어 있지 않다.",
      "기록된 공동 식량 요청을 모두 충당했다.",
      "아직 완료일의 식량 수급 기록이 없다.",
      "인·일분을 충당하지 못했다.",
      "주민용 배급이다. 여행자는 상점에서 식량·연료를 살 수 있다.",
      "마을 배급으로 환산되는 상점 식량",
      "인·일분은 창고 수량과 별도다. 다른 먹거리는 거래 목록을 확인하자."
    ],
    "numericPrecisionLimit": "Text is derived from actual values but formatted to at most 2 decimals; this is not an exact raw-unit dump. A tiny positive unmet could format to 0 while its positive-condition shortfall sentence remains.",
    "iconAccessibility": "ItemIcon is decorative aria-hidden with empty img alt; adjacent status, numeric and ledger text carry meaning. Static source review only, no assistive-technology runtime test.",
    "notAProductValidation": "No UI or Core execution, threshold test, economy simulation or gameplay result is asserted.",
    "marketRationAggregation": {
      "helperField": "marketRationFood",
      "helperExpression": "quantize(settlementCommodity(w, stock, Food) - max(0, stock.reserve.Food ?? 0))",
