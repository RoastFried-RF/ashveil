{
  "description": "실제 타이틀에서 고정 시드로 시작하고 한 턴 대기·남쪽 회전 뒤 소지품 UI를 기록한다.",
  "viewports": [{"width": 1440, "height": 1080}, {"width": 1366, "height": 768}],
  "steps": [
    {"action": "waitFor", "selector": "[data-testid=seed]"},
    {"action": "fill", "selector": "[data-testid=seed]", "value": "ashveil-harness-smoke"},
    {"action": "snapshot", "name": "00-title"},
    {"action": "click", "selector": "[data-testid=start]"},
    {"action": "waitFor", "selector": "[data-testid=map] canvas"},
    {"action": "snapshot", "name": "01-world"},
    {"action": "press", "key": "Period"},
    {"action": "press", "key": "Control+ArrowDown"},
    {"action": "press", "key": "i"},
    {"action": "waitFor", "selector": "[data-testid=bag]"},
    {"action": "snapshot", "name": "02-inventory"}
  ]
}
