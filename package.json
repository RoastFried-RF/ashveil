{
  "name": "ashveil",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "ASHVEIL — hardcore turn-based RPG × story-generating sandbox (prototype)",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "lint": "eslint .",
    "typecheck": "vue-tsc --noEmit",
    "sim": "tsx tools/sim.ts",
    "validate-defs": "tsx tools/validate-defs.ts",
    "benchmark": "tsx tools/benchmark.ts",
    "sim:batch": "tsx tools/sim-batch.ts",
    "schema": "tsx tools/export-schema.ts",
    "validate-schema": "python3 tools/validate-schema.py",
    "golden:update": "tsx tools/update-golden.ts --write",
    "mod:package": "tsx tools/package-mod.ts",
    "defs": "tsx tools/ashveil-defs.ts",
    "sim:run": "tsx tools/ashveil-sim.ts",
    "game:check": "node tools/game-harness.mjs",
    "game:preview-check": "tsx tools/game-harness-preview.ts"
  },
  "dependencies": {
    "@fontsource/gowun-batang": "^5.3.0",
    "pixi.js": "^8.22.0",
    "quickjs-emscripten": "0.32.0",
    "vue": "^3.5.43"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.5",
    "@vitejs/plugin-vue": "^6.0.10",
    "eslint": "^10.12.0",
    "eslint-plugin-vue": "^10.11.1",
    "fast-check": "^4.10.2",
    "globals": "^17.13.0",
    "playwright-core": "1.56.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.71.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.4",
    "vue-tsc": "^3.3.13"
  }
}
